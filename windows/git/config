; Extra global Git config, read from ~/.config/git/config.
; Git reads this file before ~/.gitconfig, so company settings in ~/.gitconfig win.
; Only the user name is set. No email, credential, proxy or url settings here on purpose.

[user]
	name = khalil hadji

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[delta]
	navigate = true
	side-by-side = true
	light = true
	syntax-theme = Catppuccin Latte
