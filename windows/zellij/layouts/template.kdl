// Copy this file to <name>.kdl, set cwd to the project folder, then start it with: z <name>
// All panes start in cwd (~ is the home folder).

layout {
    cwd "~"

    // bar at the bottom: children first, then the bar
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    // Programs start inside pwsh with -NoExit: closing nvim or gemini drops into the shell
    // of the same pane (with the profile loaded), like in tmux.
    tab name="editor" focus=true {
        pane command="pwsh" {
            args "-NoLogo" "-NoExit" "-Command" "nvim"
        }
    }

    tab name="shell-prompt" {
        pane
    }


    tab name="coding-agent" {
        pane command="pwsh" {
            args "-NoLogo" "-NoExit" "-Command" "gemini"
        }
    }
}
