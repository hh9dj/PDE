// Layout "dots": same 3 windows as common/tmux/sessions/dots.yaml.
// Start: z dots   (the profile does Set-Location to the PDE repo, then starts this layout)
// No cwd here: the layout inherits the directory of the command that starts it.

layout {
    // bar at the bottom: children first, then the bar
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    tab name="editor" focus=true {
        pane command="nvim"
    }

    tab name="shell-prompt" {
        pane
    }

    tab name="coding-agent" {
        pane command="gemini"
    }
}
