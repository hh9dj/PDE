{
    "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
    "$docs": "https://code.claude.com/docs/en/keybindings",
    "bindings": [
        {
            "context": "Chat",
            "bindings": {
                "ctrl+g": null,
                "ctrl+s": null,
                "ctrl+e": "chat:externalEditor",
                "ctrl+l": "chat:modelPicker",
                "ctrl+s r": "command:resume",
                "ctrl+s r": "chat:thinkingToggle",
                "shift+enter": "chat:newline"
            }
        },
        {
            "context": "Global",
            "bindings": {
                "ctrl+r": null,
                "ctrl+t": null,
                "ctrl+o": "app:toggleTranscript"
            }
        },
        {
            "context": "Scroll",
            "bindings": {
                "ctrl+end": null,
                "ctrl+g": "scroll:bottom",
                "ctrl+alt+d": "scroll:pageDown",
                "ctrl+alt+u": "scroll:pageUp"
            }
        }
    ]
}
