{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "theme": "light",
    "model": "opus",
    "permissions": {
        "deny": ["Read(**/.env)", "Read(**/.env.*)"]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "rtk hook claude",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
