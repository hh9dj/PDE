{
    "$schema": "https://opencode.ai/config.json",
    "model": "deepseek/deepseek-flash",
    "default_agent": "plan",
    "agent": {
        "plan": {
            "model": "deepseek/deepseek-v4-pro"
        },
        "build": {
            "model": "deepseek/deepseek-flash"
        }
    },
    "permission": {
        "read": {
            "*": "allow",
            "**/*.env": "deny",
            "**/*.env.*": "deny"
        },
        "external_directory": {
            "~/workmux/**": "allow",
            "/tmp": "allow"
        }
    }
}
