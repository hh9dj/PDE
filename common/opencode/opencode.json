{
    "$schema": "https://opencode.ai/config.json",
    "model": "deepseek/deepseek-flash",
    "provider": {
        "deepseek": {
            "models": {
                "deepseek-flash": {
                    "options": {
                        "reasoningEffort": "high"
                    }
                }
            }
        }
    },
    "permission": {
        "read": {
            "*": "allow",
            "**/*.env": "deny",
            "**/*.env.*": "deny"
        },
        "external_directory": {
            "~/workmux/**": "allow",
            "/tmp": "allow"
        }
    }
}
